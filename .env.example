# ============================================
# Переменные окружения для проекта git-guru-lesson
# ============================================
# Скопируйте этот файл в .env и заполните свои значения.
# Никогда не коммитьте .env файл с реальными данными!
#
# Как использовать:
#   export $(cat .env | xargs)   # Linux/macOS
#   или читайте .env прямо в коде через dotenv-библиотеку
# ============================================

# ─── RANEPA (портал Т11) ──────────────────────
# Логин и пароль для авторизации на t11.ranepa.ru
RANEPA_LOGIN=
RANEPA_PASSWORD=

# ─── BrowserStack ──────────────────────────────
# Данные для запуска мобильных тестов в облаке BrowserStack
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
BROWSERSTACK_APP=

# ─── Telegram (Allure Notifications) ───────────
# Токен бота и ID чата для отправки уведомлений
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
